@import "tailwindcss";

@theme inline {
  --font-sans: var(--font-sans);
  --font-serif: var(--font-display);
  --font-mono: var(--font-mono);
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-border: var(--border);
  --color-ring: var(--ring);
}

:root {
  color-scheme: light;
  --background: oklch(0.975 0.012 78);
  --foreground: oklch(0.21 0.03 48);
  --card: oklch(0.995 0.006 78);
  --card-foreground: oklch(0.21 0.03 48);
  --popover: oklch(0.995 0.006 78);
  --popover-foreground: oklch(0.21 0.03 48);
  --primary: oklch(0.49 0.18 35);
  --primary-foreground: oklch(0.985 0.004 78);
  --secondary: oklch(0.93 0.018 72);
  --secondary-foreground: oklch(0.21 0.03 48);
  --muted: oklch(0.945 0.014 74);
  --muted-foreground: oklch(0.42 0.026 52);
  --accent: oklch(0.91 0.055 55);
  --accent-foreground: oklch(0.21 0.03 48);
  --destructive: oklch(0.50 0.20 25);
  --destructive-foreground: oklch(0.985 0.004 78);
  --border: oklch(0.84 0.025 66);
  --input: oklch(0.94 0.015 72);
  --ring: oklch(0.49 0.18 35);
  --radius: 0.55rem;
  --surface-inverse: oklch(0.20 0.028 50);
  --text-inverse: oklch(0.95 0.012 78);
  --inverse-muted: oklch(0.73 0.018 72);
  --line-inverse: oklch(0.34 0.026 52);
  --gradient-bg: linear-gradient(135deg, oklch(0.975 0.012 78), oklch(0.945 0.028 53));
  --shadow-color: oklch(0.20 0.03 48 / 0.08);
}

.dark {
  color-scheme: dark;
  --background: oklch(0.17 0.018 55);
  --foreground: oklch(0.95 0.012 78);
  --card: oklch(0.215 0.018 55);
  --card-foreground: oklch(0.95 0.012 78);
  --popover: oklch(0.235 0.019 55);
  --popover-foreground: oklch(0.95 0.012 78);
  --primary: oklch(0.76 0.16 48);
  --primary-foreground: oklch(0.17 0.018 55);
  --secondary: oklch(0.27 0.022 55);
  --secondary-foreground: oklch(0.95 0.012 78);
  --muted: oklch(0.235 0.019 55);
  --muted-foreground: oklch(0.72 0.018 72);
  --accent: oklch(0.31 0.07 42);
  --accent-foreground: oklch(0.95 0.012 78);
  --destructive: oklch(0.68 0.18 25);
  --destructive-foreground: oklch(0.15 0.01 25);
  --border: oklch(0.34 0.026 52);
  --input: oklch(0.215 0.018 55);
  --ring: oklch(0.76 0.16 48);
  --surface-inverse: oklch(0.945 0.012 78);
  --text-inverse: oklch(0.19 0.025 50);
  --inverse-muted: oklch(0.45 0.026 52);
  --line-inverse: oklch(0.82 0.02 72);
  --gradient-bg: linear-gradient(135deg, oklch(0.17 0.018 55), oklch(0.20 0.032 38));
  --shadow-color: oklch(0 0 0 / 0.22);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 5rem; }
body {
  margin: 0;
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-sans), ui-sans-serif, system-ui, sans-serif;
  font-size: 1rem;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
button, input, select, textarea { font: inherit; }
button, a, summary { -webkit-tap-highlight-color: transparent; }
a { color: inherit; text-decoration: none; }
::selection { background: var(--primary); color: var(--primary-foreground); }

.container { width: min(100% - 3rem, 76rem); margin-inline: auto; }
.section { padding-block: clamp(5rem, 10vw, 8.5rem); }
.site-header { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid color-mix(in oklch, var(--border), transparent 30%); background: color-mix(in oklch, var(--background), transparent 12%); backdrop-filter: blur(18px); }
.header-inner { min-height: 4.75rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
.brand-link, .desktop-nav a, .footer-links a, .footer-end a { border-radius: 0.25rem; }
.logo { display: inline-flex; align-items: center; gap: 0.65rem; font-size: 1.05rem; font-weight: 750; letter-spacing: -0.035em; }
.logo-mark { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--foreground); color: var(--background); font-family: var(--font-display), Georgia, serif; font-size: 1.35rem; font-weight: 400; }
.desktop-nav { display: flex; align-items: center; gap: 1.8rem; margin-left: auto; }
.desktop-nav a { color: var(--muted-foreground); font-size: 0.85rem; font-weight: 650; transition: color 160ms cubic-bezier(0.23, 1, 0.32, 1); }
.desktop-nav a:hover { color: var(--foreground); }
.header-actions { display: flex; align-items: center; gap: 0.65rem; }
.icon-button { width: 2.65rem; height: 2.65rem; display: grid; place-items: center; border: 1px solid var(--border); border-radius: 50%; background: transparent; color: var(--foreground); cursor: pointer; transition: background-color 160ms cubic-bezier(0.23, 1, 0.32, 1), transform 160ms cubic-bezier(0.23, 1, 0.32, 1); }
.icon-button:hover { background: var(--secondary); transform: rotate(-8deg); }
.button { min-height: 2.9rem; display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem; padding: 0.78rem 1.15rem; border: 1px solid transparent; border-radius: var(--radius); font-size: 0.88rem; font-weight: 750; line-height: 1; cursor: pointer; transition: background-color 180ms cubic-bezier(0.23, 1, 0.32, 1), color 180ms cubic-bezier(0.23, 1, 0.32, 1), transform 180ms cubic-bezier(0.23, 1, 0.32, 1), box-shadow 180ms cubic-bezier(0.23, 1, 0.32, 1); }
.button:hover { transform: translateY(-2px); }
.button:disabled { cursor: not-allowed; opacity: 0.65; transform: none; }
.button-small { min-height: 2.65rem; padding: 0.65rem 1rem; font-size: 0.82rem; }
.button-dark { background: var(--foreground); color: var(--background); }
.button-dark:hover { box-shadow: 0 0.5rem 1.5rem var(--shadow-color); }
.button-primary { background: var(--primary); color: var(--primary-foreground); box-shadow: 0 0.75rem 2rem color-mix(in oklch, var(--primary), transparent 78%); }
.button-primary:hover { background: color-mix(in oklch, var(--primary), var(--foreground) 10%); box-shadow: 0 0.9rem 2.5rem color-mix(in oklch, var(--primary), transparent 70%); }
.button-light { background: var(--text-inverse); color: var(--surface-inverse); }
.button-light:hover { background: var(--primary); color: var(--primary-foreground); }
:where(a, button, input, select, textarea, summary):focus-visible { outline: 3px solid var(--ring); outline-offset: 3px; }

.hero { position: relative; overflow: hidden; padding-top: clamp(4.5rem, 10vw, 8rem); background: var(--gradient-bg); }
.hero-orbit { position: absolute; width: 30rem; height: 30rem; border: 1px solid color-mix(in oklch, var(--primary), transparent 70%); border-radius: 50%; top: -19rem; right: -6rem; box-shadow: 0 0 0 5rem color-mix(in oklch, var(--primary), transparent 96%), 0 0 0 10rem color-mix(in oklch, var(--primary), transparent 97%); }
.hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(22rem, 0.85fr); align-items: center; gap: clamp(3rem, 8vw, 7rem); }
.eyebrow { margin: 0; color: var(--primary); font-family: var(--font-mono), ui-monospace, monospace; font-size: 0.72rem; font-weight: 650; letter-spacing: 0.1em; text-transform: uppercase; }
.hero h1 { max-width: 47rem; margin: 1.5rem 0 1.6rem; font-family: var(--font-display), Georgia, serif; font-size: clamp(3.65rem, 7.3vw, 7.1rem); font-weight: 400; letter-spacing: -0.048em; line-height: 0.88; }
.hero h1 em { color: var(--primary); font-weight: 400; }
.hero-intro { max-width: 40rem; margin: 0; color: var(--muted-foreground); font-size: clamp(1.05rem, 1.8vw, 1.27rem); line-height: 1.65; }
.hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem; margin-top: 2.25rem; }
.text-link, .text-button { min-height: 2.75rem; display: inline-flex; align-items: center; gap: 0.5rem; border: 0; border-bottom: 1px solid var(--foreground); background: transparent; color: var(--foreground); font-weight: 700; cursor: pointer; }
.text-link svg { transition: transform 180ms cubic-bezier(0.23, 1, 0.32, 1); }
.text-link:hover svg { transform: translateY(3px); }
.message-board { position: relative; border: 1px solid color-mix(in oklch, var(--border), transparent 15%); border-radius: 1rem; background: var(--card); box-shadow: 0 1.5rem 4rem var(--shadow-color); transform: rotate(1.7deg); }
.message-board::before { content: ""; position: absolute; inset: -0.65rem 0.65rem 0.65rem -0.65rem; z-index: -1; border: 1px solid color-mix(in oklch, var(--primary), transparent 40%); border-radius: 1rem; background: color-mix(in oklch, var(--primary), transparent 90%); transform: rotate(-3.5deg); }
.board-header, .board-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.2rem; font-family: var(--font-mono), monospace; font-size: 0.68rem; }
.board-header { border-bottom: 1px solid var(--border); }
.board-header > div { display: flex; align-items: center; gap: 0.5rem; }
.board-dot { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--primary); }
.status-pill { padding: 0.25rem 0.5rem; border-radius: 99rem; background: var(--accent); color: var(--accent-foreground); }
.board-main { padding: clamp(1.5rem, 4vw, 2.6rem); }
.board-label { margin-bottom: 1rem; color: var(--muted-foreground); font-family: var(--font-mono), monospace; font-size: 0.67rem; text-transform: uppercase; letter-spacing: 0.1em; }
.before-copy { margin: 0; color: var(--muted-foreground); font-size: 0.88rem; text-decoration: line-through; text-decoration-color: var(--primary); }
.rewrite-arrow { width: 2rem; height: 2rem; display: grid; place-items: center; margin: 1rem 0; border-radius: 50%; background: var(--secondary); color: var(--primary); }
.after-copy { margin: 0; font-family: var(--font-display), Georgia, serif; font-size: clamp(1.75rem, 3vw, 2.6rem); letter-spacing: -0.03em; line-height: 1.05; }
.board-tags { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 1.5rem; }
.board-tags span { padding: 0.38rem 0.58rem; border: 1px solid var(--border); border-radius: 0.35rem; color: var(--muted-foreground); font-size: 0.68rem; font-weight: 650; }
.board-footer { justify-content: flex-start; border-top: 1px solid var(--border); color: var(--muted-foreground); }
.board-footer p { margin: 0; }
.mini-stack { display: flex; }
.mini-stack span { width: 1.3rem; height: 1.3rem; margin-left: -0.3rem; border: 2px solid var(--card); border-radius: 50%; background: var(--primary); }
.mini-stack span:nth-child(2) { background: var(--foreground); }.mini-stack span:nth-child(3) { background: var(--accent); }
.capability-strip { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; margin-top: clamp(5rem, 10vw, 8rem); padding-block: 1.4rem; border-top: 1px solid var(--border); color: var(--muted-foreground); font-size: 0.72rem; font-weight: 750; letter-spacing: 0.08em; text-transform: uppercase; }

.section-kicker { display: flex; align-items: center; gap: 0.7rem; color: var(--muted-foreground); font-family: var(--font-mono), monospace; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; }
.section-kicker span { display: grid; place-items: center; width: 1.8rem; height: 1.8rem; border: 1px solid var(--border); border-radius: 50%; color: var(--primary); }
.section-kicker p { margin: 0; }
.section-kicker.light { color: var(--inverse-muted); }.section-kicker.light span { border-color: var(--line-inverse); }
.problem-section { background: var(--card); }
.problem-grid { display: grid; grid-template-columns: 0.6fr 1.4fr; gap: 3rem; }
.problem-copy h2, .section-heading h2, .process-intro h2, .split-heading h2, .about-copy h2, .faq-grid h2, .contact-copy h2 { margin: 0; font-family: var(--font-display), Georgia, serif; font-size: clamp(2.6rem, 5.4vw, 5rem); font-weight: 400; letter-spacing: -0.04em; line-height: 0.98; }
.problem-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 2.75rem; color: var(--muted-foreground); }
.problem-columns p { margin: 0; }
.section-heading { display: grid; grid-template-columns: 0.6fr 1.4fr; gap: 3rem; align-items: start; margin-bottom: 4rem; }
.section-heading h2 { max-width: 50rem; }
.service-list { border-top: 1px solid var(--border); }
.service-row { display: grid; grid-template-columns: 4rem 1fr 1fr 1fr; gap: 2rem; align-items: start; padding-block: 2.5rem; border-bottom: 1px solid var(--border); }
.service-number { color: var(--primary); font-family: var(--font-mono), monospace; font-size: 0.75rem; }
.service-title-wrap { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
.service-title-wrap h3 { margin: 0; font-family: var(--font-display), Georgia, serif; font-size: 2rem; font-weight: 400; letter-spacing: -0.025em; }
.service-title-wrap svg { color: var(--primary); transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1); }
.service-row:hover .service-title-wrap svg { transform: translate(3px, -3px); }
.service-description { margin: 0; color: var(--muted-foreground); font-size: 0.9rem; }
.service-row ul, .engagement-card ul { margin: 0; padding: 0; list-style: none; }
.service-row li { display: flex; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.65rem; font-size: 0.82rem; font-weight: 650; }
.service-row li svg { flex: 0 0 auto; margin-top: 0.23rem; color: var(--primary); }

.process-section, .contact-section { background: var(--surface-inverse); color: var(--text-inverse); }
.process-layout { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(4rem, 10vw, 8rem); }
.process-intro { position: sticky; top: 8rem; align-self: start; }
.process-intro h2 { margin-top: 1.5rem; }
.process-intro > p { max-width: 31rem; margin: 1.5rem 0 2rem; color: var(--inverse-muted); }
.process-list { margin: 0; padding: 0; list-style: none; }
.process-list li { display: grid; grid-template-columns: 2.5rem 1fr auto; gap: 1.5rem; padding-block: 2rem; border-top: 1px solid var(--line-inverse); }
.process-list li:last-child { border-bottom: 1px solid var(--line-inverse); }
.process-list li > span { font-family: var(--font-mono), monospace; color: var(--primary); font-size: 0.75rem; }
.process-list h3 { margin: 0 0 0.55rem; font-size: 1.05rem; }
.process-list p { margin: 0; color: var(--inverse-muted); font-size: 0.88rem; }
.process-list li > svg { color: var(--primary); }

.split-heading > div:last-child p { margin: 1.25rem 0 0; color: var(--muted-foreground); }
.engagement-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
.engagement-card { display: flex; flex-direction: column; min-height: 34rem; padding: 2rem; border: 1px solid var(--border); border-radius: 0.8rem; background: var(--card); }
.engagement-card.featured { background: var(--accent); }
.card-label { margin: 0 0 2.5rem; color: var(--muted-foreground); font-family: var(--font-mono), monospace; font-size: 0.68rem; font-weight: 650; text-transform: uppercase; letter-spacing: 0.09em; }
.engagement-card h3 { margin: 0; font-family: var(--font-display), Georgia, serif; font-size: 2.25rem; font-weight: 400; letter-spacing: -0.03em; }
.engagement-card > p:not(.card-label) { min-height: 6.5rem; color: var(--muted-foreground); font-size: 0.88rem; }
.card-timing { margin: 1.25rem 0; padding-block: 0.75rem; border-block: 1px solid var(--border); font-family: var(--font-mono), monospace; font-size: 0.75rem; }
.engagement-card li { margin-bottom: 0.55rem; font-size: 0.82rem; }
.engagement-card li::before { content: "—"; margin-right: 0.55rem; color: var(--primary); }
.engagement-card > a { display: inline-flex; align-items: center; gap: 0.45rem; margin-top: auto; padding-top: 2rem; color: var(--primary); font-size: 0.82rem; font-weight: 750; }

.about-section { background: var(--card); }
.about-grid { display: grid; grid-template-columns: 0.72fr 1.28fr; gap: clamp(4rem, 10vw, 8rem); align-items: center; }
.about-mark { aspect-ratio: 1; display: flex; flex-direction: column; justify-content: space-between; padding: 2rem; border-radius: 50%; background: var(--primary); color: var(--primary-foreground); transform: rotate(-5deg); }
.about-mark svg { align-self: flex-end; }.about-mark span { font-family: var(--font-display), Georgia, serif; font-size: clamp(1.8rem, 4vw, 3.4rem); line-height: 0.98; }
.about-copy h2 { margin: 1.5rem 0 2rem; }
.about-copy > p { max-width: 42rem; color: var(--muted-foreground); }
.about-principles { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2rem; }
.about-principles span { padding: 0.45rem 0.7rem; border: 1px solid var(--border); border-radius: 99rem; font-size: 0.72rem; font-weight: 700; }

.faq-grid { display: grid; grid-template-columns: 0.75fr 1.25fr; gap: clamp(3rem, 9vw, 7rem); }
.faq-grid h2 { margin-top: 1.5rem; }
.faq-list { border-top: 1px solid var(--border); }
.faq-list details { border-bottom: 1px solid var(--border); }
.faq-list summary { min-height: 4.75rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; cursor: pointer; font-weight: 750; list-style: none; }
.faq-list summary::-webkit-details-marker { display: none; }
.faq-list summary span { color: var(--primary); font-size: 1.5rem; font-weight: 400; transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1); }
.faq-list details[open] summary span { transform: rotate(45deg); }
.faq-list details p { max-width: 41rem; margin: -0.25rem 0 1.5rem; color: var(--muted-foreground); font-size: 0.9rem; }

.contact-layout { display: grid; grid-template-columns: 0.75fr 1.25fr; gap: clamp(3rem, 9vw, 7rem); }
.contact-copy { position: sticky; top: 8rem; align-self: start; }
.contact-copy h2 { margin: 1.5rem 0; }
.contact-copy > p { max-width: 29rem; color: var(--inverse-muted); }
.email-link { min-height: 2.75rem; display: inline-flex; align-items: center; gap: 0.6rem; margin-top: 1rem; color: var(--primary); font-weight: 750; }
.contact-form { padding: clamp(1.5rem, 4vw, 2.5rem); border-radius: 0.8rem; background: var(--background); color: var(--foreground); }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
.field { display: flex; flex-direction: column; gap: 0.45rem; margin-bottom: 1.2rem; }
.field label, .budget-fieldset legend { font-size: 0.78rem; font-weight: 750; }
.field input, .field select, .field textarea { width: 100%; min-height: 3rem; border: 1px solid var(--border); border-radius: 0.45rem; background: var(--input); color: var(--foreground); padding: 0.75rem 0.85rem; transition: border-color 160ms cubic-bezier(0.23, 1, 0.32, 1), background-color 160ms cubic-bezier(0.23, 1, 0.32, 1); }
.field textarea { min-height: 8.5rem; resize: vertical; }
.field input::placeholder, .field textarea::placeholder { color: var(--muted-foreground); opacity: 1; }
.field input:hover, .field select:hover, .field textarea:hover { border-color: var(--muted-foreground); }
.field [aria-invalid="true"] { border-color: var(--destructive); }
.field-hint, .field-error { margin: 0; font-size: 0.72rem; }.field-hint { color: var(--muted-foreground); }.field-error { color: var(--destructive); font-weight: 650; }
.budget-fieldset { margin: 0 0 1.25rem; padding: 0; border: 0; }
.budget-fieldset legend { margin-bottom: 0.7rem; }
.radio-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.radio-label { position: relative; cursor: pointer; }
.radio-label input { position: absolute; opacity: 0; }
.radio-label span { min-height: 2.65rem; display: inline-flex; align-items: center; padding: 0.55rem 0.75rem; border: 1px solid var(--border); border-radius: 0.4rem; color: var(--muted-foreground); font-size: 0.72rem; font-weight: 700; transition: border-color 160ms cubic-bezier(0.23, 1, 0.32, 1), background-color 160ms cubic-bezier(0.23, 1, 0.32, 1), color 160ms cubic-bezier(0.23, 1, 0.32, 1); }
.radio-label input:checked + span { border-color: var(--primary); background: var(--accent); color: var(--foreground); }
.radio-label input:focus-visible + span { outline: 3px solid var(--ring); outline-offset: 3px; }
.honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
.form-error { margin-bottom: 1rem; padding: 0.9rem; border-left: 3px solid var(--destructive); background: color-mix(in oklch, var(--destructive), transparent 92%); font-size: 0.78rem; }
.form-error p { margin: 0.2rem 0; }.form-error a { text-decoration: underline; font-weight: 750; }
.form-submit { width: 100%; }.form-note { margin: 0.7rem 0 0; color: var(--muted-foreground); text-align: center; font-size: 0.68rem; }
.spin { animation: spin 900ms linear infinite; }
.form-success { min-height: 30rem; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: clamp(2rem, 5vw, 4rem); border-radius: 0.8rem; background: var(--background); color: var(--foreground); }
.success-icon { width: 3.5rem; height: 3.5rem; display: grid; place-items: center; margin-bottom: 1.5rem; border-radius: 50%; background: var(--accent); color: var(--primary); }
.form-success h3 { margin: 0.75rem 0; font-family: var(--font-display), Georgia, serif; font-size: 2.5rem; font-weight: 400; line-height: 1; }.form-success > p:not(.eyebrow) { color: var(--muted-foreground); }

.site-footer { padding-block: 3rem; border-top: 1px solid var(--border); background: var(--card); }
.footer-grid { display: grid; grid-template-columns: 1fr auto 1fr; gap: 3rem; align-items: end; }
.footer-grid > div:first-child p, .footer-end p { margin: 0.75rem 0 0; color: var(--muted-foreground); font-size: 0.75rem; }
.footer-links { display: flex; gap: 1.5rem; font-size: 0.75rem; font-weight: 700; }
.footer-end { text-align: right; font-size: 0.8rem; font-weight: 700; }
.page-state { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; padding: 2rem; text-align: center; }
.page-state h1 { max-width: 45rem; margin: 0; font-family: var(--font-display), Georgia, serif; font-size: clamp(3rem, 7vw, 6rem); font-weight: 400; line-height: 0.95; }.page-state > p:not(.eyebrow) { max-width: 35rem; color: var(--muted-foreground); }
.skeleton { border-radius: 0.4rem; background: var(--muted); animation: pulse 1.5s ease-in-out infinite; }.state-logo { width: 2.5rem; height: 2.5rem; border-radius: 50%; }.state-title { width: min(80vw, 34rem); height: 5rem; }.state-copy { width: min(70vw, 26rem); height: 1.2rem; }

@keyframes spin { to { transform: rotate(360deg); } }
@keyframes pulse { 50% { opacity: 0.45; } }
@keyframes reveal { from { opacity: 0; transform: translateY(1.25rem); } to { opacity: 1; transform: translateY(0); } }
.reveal { animation: reveal 700ms cubic-bezier(0.23, 1, 0.32, 1) both; }.reveal-delay-1 { animation-delay: 80ms; }.reveal-delay-2 { animation-delay: 160ms; }.reveal-delay-3 { animation-delay: 240ms; }

@media (max-width: 960px) {
  .desktop-nav { display: none; }
  .hero-grid, .problem-grid, .section-heading, .process-layout, .about-grid, .faq-grid, .contact-layout { grid-template-columns: 1fr; }
  .hero-grid { gap: 4.5rem; }.message-board { width: min(100%, 34rem); margin-left: auto; }
  .section-heading { gap: 1.5rem; }.problem-grid { gap: 2rem; }.problem-columns { max-width: 45rem; }
  .service-row { grid-template-columns: 3rem 1fr 1fr; }.service-row ul { grid-column: 2 / -1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .process-intro, .contact-copy { position: static; }.process-intro { max-width: 40rem; }.process-list { margin-top: 1rem; }
  .engagement-grid { grid-template-columns: 1fr 1fr; }.engagement-card:last-child { grid-column: 1 / -1; min-height: 28rem; }
  .about-mark { width: min(75vw, 25rem); }.about-copy { max-width: 50rem; }.contact-copy { max-width: 42rem; }
  .footer-grid { grid-template-columns: 1fr 1fr; }.footer-links { order: 3; grid-column: 1 / -1; }.footer-end { text-align: right; }
}

@media (max-width: 640px) {
  .container { width: min(100% - 2rem, 76rem); }.section { padding-block: 5rem; }
  .site-header .button-small { width: 2.65rem; padding: 0; font-size: 0; }.site-header .button-small svg { width: 18px; height: 18px; }
  .header-actions { gap: 0.4rem; }.logo { font-size: 1rem; }.logo-mark { width: 1.85rem; height: 1.85rem; }
  .hero { padding-top: 4rem; }.hero h1 { font-size: clamp(3.25rem, 17vw, 5rem); }.hero-actions { align-items: stretch; flex-direction: column; }.hero-actions .button { width: 100%; }.hero-actions .text-link { align-self: flex-start; }
  .message-board { width: 95%; margin: 0 auto; transform: rotate(1deg); }.board-footer { align-items: flex-start; }.capability-strip { justify-content: flex-start; overflow-x: auto; white-space: nowrap; scrollbar-width: none; }.capability-strip span { flex: 0 0 auto; }
  .problem-columns, .form-grid { grid-template-columns: 1fr; }.problem-columns { gap: 0.75rem; }
  .service-row { grid-template-columns: 2.25rem 1fr; gap: 1.2rem; }.service-description, .service-row ul { grid-column: 2; }.service-row ul { display: block; }
  .process-list li { grid-template-columns: 2rem 1fr; gap: 1rem; }.process-list li > svg { display: none; }
  .engagement-grid { grid-template-columns: 1fr; }.engagement-card, .engagement-card:last-child { min-height: 31rem; grid-column: auto; }
  .about-mark { width: min(82vw, 21rem); }.about-principles { align-items: flex-start; flex-direction: column; }
  .contact-form { padding: 1.25rem; }.radio-row { display: grid; grid-template-columns: 1fr 1fr; }.radio-label span { width: 100%; }
  .footer-grid { grid-template-columns: 1fr; align-items: start; }.footer-links { grid-column: auto; flex-wrap: wrap; }.footer-end { text-align: left; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
}
