# Server-only Telegram credentials. Never prefix these with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public settings for /sell-on-whatsapp. These are included in the browser bundle.
NEXT_PUBLIC_WHATSAPP_PRODUCT_NAME=WhatsApp Views-to-Sales
# Optional: only use a genuine comparison value.
NEXT_PUBLIC_WHATSAPP_PRODUCT_ORIGINAL_VALUE=
# Cloudinary delivery URL for the sales video. This is public and needs no API secret.
# Example: https://res.cloudinary.com/YOUR_CLOUD_NAME/video/upload/q_auto,f_auto/YOUR_PUBLIC_ID.mp4
NEXT_PUBLIC_WHATSAPP_VIDEO_URL=
NEXT_PUBLIC_WHATSAPP_CHECKOUT_URL=
# Optional. The premium service button stays hidden when this is blank.
NEXT_PUBLIC_WHATSAPP_IMPLEMENTATION_URL=

# Paystack checkout. Keep both keys server-side; never prefix the secret with NEXT_PUBLIC_.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Example: https://copiwrite.com/payment/verify
PAYSTACK_CALLBACK_URL=
# Use a long random value in production to sign private buyer access links.
DELIVERY_ACCESS_SECRET=

# Email delivery. CONTACT_FROM must use a domain verified in Resend.
RESEND_API_KEY=
CONTACT_FROM="Copiwrite Team <info@copiwrite.com>"
CONTACT_REPLY_TO=copiwriteteam@gmail.com
